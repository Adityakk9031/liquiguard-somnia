# ==============================================================================
#  LiquiGuard Environment Configuration (Somnia Shannon Testnet - Chain 50312)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env

# --- Blockchain Network ---
SOMNIA_RPC_URL=https://api.infra.testnet.somnia.network
SOMNIA_WS_URL=wss://api.infra.testnet.somnia.network/ws
SOMNIA_CHAIN_ID=50312

# --- Relayer / Operator Key ---
# Private key for the Sentinel Keeper Daemon to sign executeProtectionHedge() txs
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# --- Deployed On-Chain Contracts (Somnia Shannon Testnet) ---
VAULT_ADDRESS=0x14b2bb3f8a25301d6ea944d571f0e7608d36c095
LENDING_POOL_ADDRESS=0x96b90274a27d7c933816ae6eae9959b3be05d260
PRICE_ORACLE_ADDRESS=0xDD2A460Bfe22BfA7c757A35F6d68813770d39712
