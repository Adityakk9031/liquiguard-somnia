TUSDC_ADDRESS=0x734a4b4d43aec0d7d58e3bae6e7b4a8fa253fd5e

# --- Frontend Public Variables ---
NEXT_PUBLIC_VAULT_ADDRESS=0x14b2bb3f8a25301d6ea944d571f0e7608d36c095
